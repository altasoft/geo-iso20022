	<xs:complexType name="GEO_PartyIdentification135__3">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">GEO_PartyIdentification135__3</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Specifies the identification of a person or an organisation.</xs:documentation>
			<xs:documentation source="Definition" xml:lang="KA">განსაზღვრავს პირის ან ორგანიზაციის იდენტიფიკაციას.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Id" type="GEO_Party38Choice">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Identification</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Unique and unambiguous identification for the account between the account owner and the account servicer.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">ანგარიშის უნიკალური და ერთმნიშვნელოვანი იდენტიფიკაცია ანგარიშის მფლობელსა და ანგარიშის მომსახურე მხარეს შორის.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="GEO_PaymentIdentification6">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">GEO_PaymentIdentification6</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Provides further means of referencing a payment transaction.</xs:documentation>
			<xs:documentation source="Definition" xml:lang="KA">მოიცავს გადახდის ოპერაციაზე დამატებითი მითითების საშუალებას.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element maxOccurs="1" minOccurs="0" name="InstrId" type="GEO_RestrictedFINXMax35Text">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InstructionIdentification</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">
						Unique identification as assigned by an instructing party for an instructed party to unambiguously identify the instruction.

						Usage: The instruction identification is a point to point reference that can be used between the instructing party and the instructed party to refer to the individual instruction. It can be included in several messages related to the instruction.
					</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">დავალების უნიკალური იდენტიფიკაცია, მინიჭებული დამვალებელი მხარის მიერ დავალებული მხარისთვის დავალების ცალსახად იდენტიფიცირების მიზნით. გამოყენება: დავალების იდენტიფიკაცია არის წერტილიდან წერტილამდე რეფერენსი, რომელიც შეიძლება გამოყენებულ იქნას დამვალებელ და დავალებულ მხარეებს შორის ინდივიდუალურ დავალებაზე მითითებისთვის. ის შეიძლება შევიდეს დავალებასთან დაკავშირებულ რამდენიმე შეტყობინებაში.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EndToEndId" type="GEO_RestrictedFINXMax35Text">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">EndToEndIdentification</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">
						Unique identification assigned by the initiating party to unambiguously identify the transaction. This identification is passed on, unchanged, throughout the entire end-to-end chain.

						Usage: The end-to-end identification can be used for reconciliation or to link tasks relating to the transaction. It can be included in several messages related to the transaction.
					</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">ინიციატორი მხარის მიერ მინიჭებული უნიკალური იდენტიფიკაცია ოპერაციის ცალსახად იდენტიფიცირებისთვის. ეს იდენტიფიკაცია უცვლელად გადაეცემა მთელ end-to-end ჯაჭვში. გამოყენება: end-to-end იდენტიფიკაცია შეიძლება გამოყენებულ იქნას შეჯერებისთვის ან ოპერაციასთან დაკავშირებული ამოცანების დასაკავშირებლად. ის შეიძლება შევიდეს ოპერაციასთან დაკავშირებულ რამდენიმე შეტყობინებაში.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UETR" type="UUIDv4Identifier">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">UETR</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Universally unique identifier to provide an end-to-end reference of a payment transaction.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">უნივერსალურად უნიკალური იდენტიფიკატორი, რომელიც უზრუნველყოფს გადახდის ოპერაციის end-to-end რეფერენსს.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="GEO_PaymentInstruction30">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">GEO_PaymentInstruction30</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Characteristics that apply to the debit side of the payment transactions included in the credit transfer initiation.</xs:documentation>
			<xs:documentation source="Definition" xml:lang="KA">მახასიათებლები, რომლებიც ეხება საკრედიტო გადარიცხვის ინიციაციაში შემავალი გადახდის ოპერაციების დებეტურ მხარეს.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PmtInfId" type="GEO_RestrictedFINXMax35Text">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PaymentInformationIdentification</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Unique identification, as assigned by a sending party, to unambiguously identify the payment information group within the message.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">გამგზავნი მხარის მიერ მინიჭებული უნიკალური იდენტიფიკაცია, რომელიც ცალსახად განსაზღვრავს შეტყობინებაში გადახდის ინფორმაციის ჯგუფს.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PmtMtd" type="GEO_PaymentMethod3Code_fixed">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PaymentMethod</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Means of payment that will be used to move the amount of money.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">გადახდის საშუალება, რომელიც გამოყენებული იქნება თანხის გადატანისთვის.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="NbOfTxs" type="Max15NumericText">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">NumberOfTransactions</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Number of individual transactions contained in the message.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">შეტყობინებაში შემავალი ინდივიდუალური ოპერაციების რაოდენობა.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="PmtTpInf" type="GEO_PaymentTypeInformation26">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">GEO_PaymentTypeInformation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Set of elements used to further specify the type of transaction.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">ელემენტების ნაკრები, რომელიც გამოიყენება ოპერაციის ტიპის დამატებით დასაზუსტებლად.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReqdExctnDt" type="DateAndDateTime2Choice">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">RequestedExecutionDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">
						Date at which the initiating party requests the clearing agent to process the payment.
						Usage: This is the date on which the debtor's account is to be debited. If payment by cheque, the date when the cheque must be generated by the bank.
					</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">თარიღი, როდესაც ინიციატორი მხარე კლირინგის აგენტს სთხოვს გადახდის დამუშავებას. გამოყენება: ეს არის თარიღი, როდესაც დებიტორის ანგარიში უნდა დადებეტდეს. ჩეკით გადახდის შემთხვევაში — თარიღი, როდესაც ბანკმა უნდა შექმნას ჩეკი.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Dbtr" type="GEO_PartyIdentification135__1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Debtor</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Party that owes an amount of money to the (ultimate) creditor.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">მხარე, რომელსაც თანხა ეკისრება (საბოლოო) კრედიტორის მიმართ.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DbtrAcct" type="GEO_CashAccount38__1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DebtorAccount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Unambiguous identification of the account of the debtor to which a debit entry will be made as a result of the transaction.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">დებიტორის იმ ანგარიშის ერთმნიშვნელოვანი იდენტიფიკაცია, რომელზეც ოპერაციის შედეგად დებეტის ჩანაწერი აისახება.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DbtrAgt" type="GEO_BranchAndFinancialInstitutionIdentification6">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DebtorAgent</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Financial institution servicing an account for the debtor.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">ფინანსური ინსტიტუტი, რომელიც ემსახურება დებიტორის ანგარიშს.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="DbtrAgtAcct" type="GEO_CashAccount38__1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DebtorAgentAccount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Unambiguous identification of the account of the debtor agent at its servicing agent in the payment chain.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">დებიტორის აგენტის ანგარიშის ერთმნიშვნელოვანი იდენტიფიკაცია მის მომსახურე აგენტთან გადახდის ჯაჭვში.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="InstrForDbtrAgt" type="GEO_RestrictedFINXMax140Text">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InstructionForDebtorAgent</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Further information related to the processing of the payment instruction, that may need to be acted upon by the debtor agent, depending on agreement between debtor and the debtor agent.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">გადახდის დავალების დამუშავებასთან დაკავშირებული დამატებითი ინფორმაცია, რომლის შესრულებაც შეიძლება დასჭირდეს დებიტორის აგენტს, დებიტორსა და დებიტორის აგენტს შორის შეთანხმების მიხედვით.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="1" name="CdtTrfTxInf" type="GEO_CreditTransferTransaction34">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CreditTransferTransactionInformation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Provides information on the individual transaction(s) included in the message.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">მოიცავს ინფორმაციას შეტყობინებაში შემავალი ინდივიდუალური ოპერაციების შესახებ.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="GEO_PaymentMethod3Code_fixed">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">GEO_PaymentMethod3Code</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Specifies the transfer method that will be used to transfer an amount of money.</xs:documentation>
			<xs:documentation source="Definition" xml:lang="KA">განსაზღვრავს გადახდის მეთოდს, რომელიც გამოყენებული იქნება თანხის გადატანისთვის.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="TRF">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CreditTransfer</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Payment method is a credit transfer.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">გადახდის მეთოდია კრედიტური გადარიცხვა.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="GEO_PaymentTypeInformation26">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">GEO_PaymentTypeInformation26</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Provides further details of the type of payment.</xs:documentation>
			<xs:documentation source="Definition" xml:lang="KA">მოიცავს გადახდის ტიპის დამატებით დეტალებს.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element maxOccurs="1" minOccurs="0" name="InstrPrty" type="Priority2Code">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InstructionPriority</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Urgency or order of importance that the originator would like the recipient of the payment instruction to apply to the processing of the payment instruction.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">სასწრაფოობის ან მნიშვნელობის რიგი, რომლის გამოყენებასაც წარმომდგენი სთხოვს გადახდის დავალების მიმღებს გადახდის დავალების დამუშავებისას.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="SvcLvl" type="GEO_ServiceLevel8Choice">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ServiceLevel</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Agreement under which or rules under which the transaction should be processed.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">შეთანხმება ან წესები, რომელთა მიხედვითაც ოპერაცია უნდა დამუშავდეს.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="LclInstrm" type="GEO_LocalInstrument2Choice">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">LocalInstrument</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">
						User community specific instrument.

						Usage: This element is used to specify a local instrument, local clearing option and/or further qualify the service or service level.
					</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">მომხმარებელთა საზოგადოებისთვის სპეციფიკური ინსტრუმენტი. გამოყენება: ეს ელემენტი გამოიყენება ადგილობრივი ინსტრუმენტის, ადგილობრივი კლირინგის ვარიანტის დასაზუსტებლად და/ან მომსახურების ან მომსახურების დონის დამატებით დასაკვალიფიცირებლად.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="CtgyPurp" type="GEO_CategoryPurpose1Choice">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CategoryPurpose</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">
						Specifies the high level purpose of the instruction based on a set of pre-defined categories.
						Usage: This is used by the initiating party to provide information concerning the processing of the payment. It is likely to trigger special processing by any of the agents involved in the payment chain.
					</xs:documentation>
					<xs:documentation source="Definition" xml:lang="KA">განსაზღვრავს დავალების მაღალი დონის დანიშნულებას წინასწარ განსაზღვრული კატეგორიების საფუძველზე. გამოყენება: ინიციატორი მხარე ამას იყენებს გადახდის დამუშავებასთან დაკავშირებული ინფორმაციის მისაწოდებლად. სავარაუდოდ, ეს გამოიწვევს სპეციალურ დამუშავებას გადახდის ჯაჭვში ჩართული რომელიმე აგენტის მიერ.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="GEO_PersonIdentification13">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">GEO_PersonIdentification13</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Unique and unambiguous way to identify a person.</xs:documentation>
			<xs:documentation source="Definition" xml:lang="KA">პირის იდენტიფიკაციის უნიკალური და ერთმნიშვნელოვანი საშუალება.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Othr" type="GEO_GenericPersonIdentification1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Other</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Unique identification of an account, as assigned by the account servicer, using an identification scheme.</xs:documentation>
