			<xs:documentation source="Definition" xml:lang="KA">რეგულატორული და/ან კანონმდებლობით დადგენილი მოთხოვნების გამო საჭირო ინფორმაცია.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element maxOccurs="1" minOccurs="0" name="DbtCdtRptgInd" type="RegulatoryReportingType1Code">
